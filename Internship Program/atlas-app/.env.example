# Required. Connection string for a Neon Postgres database (or any Postgres
# reachable over HTTP-compatible driver). Create a free project at
# https://neon.tech, then copy its pooled connection string here.
DATABASE_URL=

# Optional. Without this set, role classification (ingest) and the findings
# narrative run on their deterministic fallback paths — the app is fully
# functional either way, per the visible-fallback pattern (see README).
ANTHROPIC_API_KEY=

# Optional override of the model id used for both AI-assisted behaviours.
# ANTHROPIC_MODEL=claude-sonnet-5
