# Required. Connection string for a Neon Postgres database (or any Postgres
# reachable over HTTP-compatible driver). Create a free project at
# https://neon.tech, then copy its pooled connection string here.
DATABASE_URL=

# Needed for four behaviours. Role classification and the findings narrative
# fall back to deterministic paths without it, but the other two simply do not
# work: reading an org chart out of an image or a scanned PDF, and reading the
# instructions typed in the upload screen's context box. Both say so plainly
# rather than degrading silently, per the visible-fallback pattern (see README).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional override of the model id used for both AI-assisted behaviours.
# ANTHROPIC_MODEL=claude-sonnet-5
